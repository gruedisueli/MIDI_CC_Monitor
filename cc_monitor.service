[Unit]
Description=MIDI CC Monitor
After=network.target sound.target

[Service]
ExecStart=/usr/bin/python3 /home/patch/MIDI_CC_Monitor/cc_monitor.py
WorkingDirectory=/home/patch/MIDI_CC_Monitor
Restart=always
RestartSec=2
User=patch
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
